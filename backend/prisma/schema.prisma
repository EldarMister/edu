// EDU POS Prisma schema
// Полная схема БД по ТЗ §13. На этапах 1–4 используются: User, Hall, Table,
// Category, Dish, Order, OrderItem, Payment, KitchenEvent.
// Остальные модели (Incident, PenaltyReward, AuditLog) заведены заранее
// для production-ready основы и будут задействованы на этапах 6–7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  WAITER
  KITCHEN
  BAR
  ADMIN
  OWNER
}

// Провайдер native push. EXPO остаётся default для обратной совместимости
// с уже установленным React Native клиентом.
enum PushProvider {
  EXPO
  FCM
}

enum TableStatus {
  free // свободен
  occupied // занят
  sent_to_kitchen // заказ отправлен на кухню
  accepted // кухня приняла
  cooking // готовится
  ready // готов
  served // вынесен
  waiting_payment // ожидание оплаты
  paid // оплачен
}

enum OrderStatus {
  draft
  sent_to_kitchen
  accepted_by_kitchen
  cooking
  ready
  picked_up
  served
  waiting_payment
  paid
  rejected
  partially_rejected
  cancelled
}

enum OrderItemStatus {
  new
  accepted
  cooking
  ready
  rejected
  served
  cancelled
}

enum DiscountType {
  none
  percent
  fixed
}

enum PaymentMethod {
  qr
  cash
  card
  mixed // смешанная: часть наличными, часть QR (детали — в строках Payment)
}

enum PaymentStatus {
  pending
  paid
  refunded
  cancelled
}

enum OrderRefundStatus {
  pending
  approved
  rejected
}

enum PaymentSource {
  normal
  split
}

enum WaiterShiftStatus {
  active
  closed
}

enum KitchenEventType {
  cancel
  change
  accept
  reject_order
  reject_item
  ready_order
  ready_item
}

enum IncidentStatus {
  new
  in_progress
  closed
}

enum PenaltyType {
  penalty
  reward
}

enum ReceiptPrintStatus {
  pending // ожидает решения администратора
  approved // администратор подтвердил
  rejected // администратор отклонил
  printed // чек распечатан / отправлен на печать
}

enum ReceiptPrintType {
  receipt // обычный (финальный) чек
  preliminary // предварительный чек (предчек)
}

// ---------- Склад: сырьё / техкарты / закупки / движения ----------

enum StockMovementType {
  purchase // приход (закупка)
  sale // списание по техкарте при продаже
  return // возврат при отмене/отказе
  correction // ручная корректировка
  cancel // отмена операции
  inventory
  writeoff
  transfer
  supplier_return
  production
  processing
}

enum StockMovementSource {
  purchase // источник — закупка
  order // источник — заказ
  manual // ручная операция
  inventory
  writeoff
  transfer
  supplier_return
  production
  processing
}

enum WarehouseDocumentKind {
  inventory
  writeoff
  transfer
  supplier_return
}

enum WarehouseInventoryMode {
  full
  partial
}

enum WarehouseDocumentStatus {
  draft
  submitted
  posted
  reversed
}

enum WarehouseWriteoffReason {
  spoilage
  expired
  damage
  staff_meal
  tasting
  household
  other
}

enum PurchaseStatus {
  draft // черновик
  completed // проведена
  cancelled // отменена
}

// Тип единицы измерения сырья. База: mass→г, volume→мл, count→шт.
enum IngredientKind {
  raw
  beverage
  goods
  preparation
  prepared_dish
  consumable
}

enum IngredientUnitType {
  mass // масса (г, кг)
  volume // объём (мл, л)
  count // штуки (шт)
}

// ---------- Models ----------

// Статус кафе на платформе: active — работает; suspended — приостановлено (вход персонала
// и QR-меню заблокированы). Приостановку ставит супер-админ вручную или cron по «оплачено до».
enum CafeStatus {
  active
  suspended
}

// Заведение (арендатор). Все бизнес-данные привязаны к кафе через cafe_id.
// Мультитенантность, фаза 1: cafe_id добавлен nullable во все таблицы и бэкфиллен «Кафе #1».
model Cafe {
  staffPositions StaffPosition[]
  financeAccounts FinanceAccount[]
  financeCategories FinanceCategory[]
  financeEntries FinanceEntry[]
  salaryAccruals SalaryAccrual[]
  employeeSalaryRates EmployeeSalaryRate[]
  warehouseSuppliers WarehouseSupplier[]
  warehousePackages WarehousePackage[]
  ingredientCategories IngredientCategory[]
  writeoffReasons WriteoffReason[]
  processingDocuments ProcessingDocument[]
  id              String     @id @default(uuid())
  name            String
  isActive        Boolean    @default(true) @map("is_active")
  // Подписка / платформенный контроль.
  status          CafeStatus @default(active)
  paidUntil       DateTime?  @map("paid_until") // оплачено до; cron приостанавливает после
  suspendedAt     DateTime?  @map("suspended_at")
  suspendedReason String?    @map("suspended_reason") // напр. «не оплачено» или текст супер-админа
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  preparationStations PreparationStation[]
  warehouses Warehouse[]

  @@map("cafes")
}

// Платформенный супер-админ (управляет кафе). Вне мультитенантности — НЕ привязан к кафе.
model PlatformAdmin {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_admins")
}

enum FinanceAccountType {
  cash
  noncash
}

enum FinanceCategoryKind {
  income
  expense
  both
}

enum FinanceEntryKind {
  income
  expense
  transfer
  sale
  refund
  salary
  adjustment
}

model FinanceAccount {
  id             String             @id @default(uuid())
  cafeId         String             @map("cafe_id")
  name           String
  type           FinanceAccountType
  isDefault      Boolean            @default(false) @map("is_default")
  isCollection   Boolean            @default(false) @map("is_collection")
  openingBalance Decimal            @default(0) @map("opening_balance") @db.Decimal(18, 2)
  createdAt      DateTime           @default(now()) @map("created_at")
  archivedAt     DateTime?          @map("archived_at")
  cafe           Cafe               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  entries        FinanceEntry[]     @relation("FinanceAccountEntries")
  counterEntries FinanceEntry[]    @relation("FinanceCounterAccount")

  @@unique([cafeId, id])
  @@unique([cafeId, name])
  @@index([cafeId, archivedAt])
  @@map("finance_accounts")
}

model FinanceCategory {
  id          String              @id @default(uuid())
  cafeId      String              @map("cafe_id")
  name        String
  kind        FinanceCategoryKind
  parentId    String?             @map("parent_id")
  showOnPos   Boolean             @default(false) @map("show_on_pos")
  showInProfitLoss Boolean        @default(true) @map("show_in_profit_loss")
  userIds     String[]            @default([]) @map("user_ids")
  positionIds String[]            @default([]) @map("position_ids")
  createdAt   DateTime            @default(now()) @map("created_at")
  cafe        Cafe                @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  parent      FinanceCategory?    @relation("FinanceCategoryParent", fields: [cafeId, parentId], references: [cafeId, id], onDelete: NoAction)
  children    FinanceCategory[]   @relation("FinanceCategoryParent")
  entries     FinanceEntry[]

  @@unique([cafeId, id])
  @@unique([cafeId, kind, name])
  @@index([cafeId, parentId])
  @@map("finance_categories")
}

model SalaryAccrual {
  id           String         @id @default(uuid())
  cafeId       String         @map("cafe_id")
  userId       String         @map("user_id")
  employeeName String         @map("employee_name")
  month        String
  amount       Decimal        @db.Decimal(18, 2)
  note         String?
  calculation  Json?
  supplemental Boolean        @default(false)
  revision     Int            @default(0)
  history      Json           @default("[]")
  voidedAt     DateTime?      @map("voided_at")
  voidReason   String?        @map("void_reason")
  actorId      String         @map("actor_id")
  requestKey   String         @map("request_key")
  createdAt    DateTime       @default(now()) @map("created_at")
  cafe         Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  payments     FinanceEntry[]

  @@unique([cafeId, id])
  @@unique([cafeId, requestKey])
  @@index([cafeId, month])
  @@map("salary_accruals")
}

model FinanceEntry {
  id                    String           @id @default(uuid())
  cafeId                String           @map("cafe_id")
  accountId             String           @map("account_id")
  kind                  FinanceEntryKind
  amount                Decimal          @db.Decimal(18, 2)
  categoryId            String?          @map("category_id")
  counterpartyAccountId String?          @map("counterparty_account_id")
  salaryAccrualId       String?          @map("salary_accrual_id")
  purchaseId            String?          @map("purchase_id")
  cashShiftId           String?          @map("cash_shift_id")
  cashCustodianId       String?          @map("cash_custodian_id")
  cashCustodyDay        DateTime?        @map("cash_custody_day") @db.Date
  pendingCashShift      Boolean          @default(false) @map("pending_cash_shift")
  actorId               String?          @map("actor_id")
  sourceKey             String?          @map("source_key")
  note                  String?
  occurredAt            DateTime         @default(now()) @map("occurred_at")
  dealDate              DateTime?        @map("deal_date") @db.Date
  createdAt             DateTime         @default(now()) @map("created_at")
  cafe                  Cafe             @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  account               FinanceAccount   @relation("FinanceAccountEntries", fields: [cafeId, accountId], references: [cafeId, id], onDelete: NoAction)
  counterparty          FinanceAccount?  @relation("FinanceCounterAccount", fields: [cafeId, counterpartyAccountId], references: [cafeId, id], onDelete: NoAction)
  category              FinanceCategory? @relation(fields: [cafeId, categoryId], references: [cafeId, id], onDelete: NoAction)
  salaryAccrual         SalaryAccrual?   @relation(fields: [cafeId, salaryAccrualId], references: [cafeId, id], onDelete: NoAction)
  purchase              Purchase?        @relation(fields: [cafeId, purchaseId], references: [cafeId, id], onDelete: NoAction)

  @@unique([cafeId, sourceKey])
  @@index([cafeId, occurredAt])
  @@index([cafeId, accountId, occurredAt])
  @@index([cafeId, salaryAccrualId])
  @@index([cafeId, purchaseId])
  @@index([cafeId, cashShiftId])
  @@index([cafeId, cashCustodyDay, cashCustodianId], map: "finance_entries_cash_custody_idx")
  @@map("finance_entries")
}

model User {
  cafeId       String?  @map("cafe_id")
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  login        String?  @unique
  passwordHash String   @map("password_hash")
  pinHash      String?  @map("pin_hash")
  role         Role
  prepStation  String?  @map("prep_station")
  isActive     Boolean  @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  lastLoginAt  DateTime? @map("last_login_at")
  // Совместимость со старыми записями; права сотрудников задаются в StaffPosition.
  permissions  Json?    @map("permissions")
  positionId   String?  @map("position_id")
  position     StaffPosition? @relation(fields: [cafeId, positionId], references: [cafeId, id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders               Order[]               @relation("WaiterOrders")
  openedPayrollOrders  Order[]               @relation("PayrollOrderOpener")
  waiterShifts         WaiterShift[]         @relation("WaiterShifts")
  payments             Payment[]
  kitchenEvents        KitchenEvent[]
  penalties            PenaltyReward[]       @relation("PenaltyTarget")
  assignedRewards      PenaltyReward[]       @relation("PenaltyAuthor")
  incidentsOwned       Incident[]            @relation("IncidentUser")
  incidentsMade        Incident[]            @relation("IncidentAuthor")
  auditLogs            AuditLog[]
  pushSubscriptions    PushSubscription[]
  devices              UserDevice[]
  receiptPrintRequests ReceiptPrintRequest[] @relation("WaiterReceiptPrints")
  cashReports          ShiftCashReport[]     @relation("WaiterCashReports")

  @@index([cafeId, prepStation])
  @@index([cafeId, positionId])
  @@map("users")
}

model StaffPosition {
  id          String   @id @default(uuid())
  cafeId      String   @map("cafe_id")
  name        String
  role        Role
  isStarter   Boolean  @default(false) @map("is_starter")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cafe  Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  users User[]
  salaryRates StaffPositionSalaryRate[]

  @@unique([cafeId, id])
  @@unique([cafeId, name])
  @@map("staff_positions")
}

model StaffPositionSalaryRate {
  cafeId          String   @map("cafe_id")
  positionId      String   @map("position_id")
  effectiveDay    String   @map("effective_day")
  hourly          Decimal  @default(0) @db.Decimal(14, 2)
  perShift        Decimal  @default(0) @map("per_shift") @db.Decimal(14, 2)
  monthly         Decimal  @default(0) @db.Decimal(14, 2)
  personalPercent Decimal  @default(0) @map("personal_percent") @db.Decimal(5, 2)
  shiftPercent    Decimal  @default(0) @map("shift_percent") @db.Decimal(5, 2)
  categoryRates   Json     @default("[]") @map("category_rates")
  position StaffPosition @relation(fields: [cafeId, positionId], references: [cafeId, id], onDelete: Cascade, map: "staff_position_salary_rates_position_fkey")

  @@id([cafeId, positionId, effectiveDay])
  @@map("staff_position_salary_rates")
}

// Independent snapshots keep past payroll intact after a position is changed or removed.
model EmployeeSalaryRate {
  cafeId          String   @map("cafe_id")
  userId          String   @map("user_id")
  effectiveDay    String   @map("effective_day")
  positionId      String?  @map("position_id")
  positionName    String   @map("position_name")
  hourly          Decimal  @default(0) @db.Decimal(14, 2)
  perShift        Decimal  @default(0) @map("per_shift") @db.Decimal(14, 2)
  monthly         Decimal  @default(0) @db.Decimal(14, 2)
  personalPercent Decimal  @default(0) @map("personal_percent") @db.Decimal(5, 2)
  shiftPercent    Decimal  @default(0) @map("shift_percent") @db.Decimal(5, 2)
  categoryRates   Json     @default("[]") @map("category_rates")
  cafe            Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, userId, effectiveDay])
  @@map("employee_salary_rates")
}

model Hall {
  cafeId    String?  @map("cafe_id")
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  floorPlan Json?    @map("floor_plan")
  floorPlanVersion Int @default(0) @map("floor_plan_version")
  useFloorPlan Boolean? @map("use_floor_plan")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tables Table[]

  @@map("halls")
}

model Table {
  cafeId    String?     @map("cafe_id")
  id        String      @id @default(uuid())
  hallId    String      @map("hall_id")
  number    Int
  name      String?
  seats     Int         @default(2)
  status    TableStatus @default(free)
  isActive  Boolean     @default(true) @map("is_active")
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  // Случайный неугадываемый токен для ссылки QR-меню стола (/menu/:qrToken).
  qrToken String @unique @default(uuid()) @map("qr_token")

  hall       Hall             @relation(fields: [hallId], references: [id], onDelete: Cascade)
  orders     Order[]
  incidents  Incident[]
  qrSessions QrTableSession[]

  // Table numbers are unique among active tables in the same hall (partial database index).
  @@index([hallId, number])
  @@map("tables")
}

model PreparationStation {
  id       String  @id @default(uuid())
  cafeId   String  @map("cafe_id")
  name     String
  isActive Boolean @default(true) @map("is_active")
  cafe     Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, name])
  @@map("preparation_stations")
}

model Category {
  cafeId      String?     @map("cafe_id")
  id          String      @id @default(uuid())
  name        String
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  prepStation String @default("kitchen") @map("prep_station")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  dishes Dish[]
  taxId  String? @map("tax_id")
  tax    MenuTax? @relation(fields: [taxId], references: [id], onDelete: NoAction)
  parentId   String?   @map("parent_id")
  parent     Category? @relation("MenuCategoryTree", fields: [cafeId, parentId], references: [cafeId, id], onDelete: NoAction, onUpdate: NoAction)
  children   Category[] @relation("MenuCategoryTree")
  inheritTax Boolean   @default(false) @map("inherit_tax")
  imageUrl   String?   @map("image_url")
  imageKey   String?   @map("image_key")

  @@unique([cafeId, id])
  @@index([cafeId, parentId])
  @@index([taxId])
  @@map("categories")
}

enum MenuTaxType {
  vat
  turnover
}

model MenuTax {
  id         String      @id @default(uuid())
  cafeId     String?     @map("cafe_id")
  name       String
  rate       Decimal     @db.Decimal(5, 2)
  type       MenuTaxType
  categories Category[]
  dishes     Dish[]

  @@index([cafeId, name])
  @@map("menu_taxes")
}

model Dish {
  cafeId            String?      @map("cafe_id")
  id                String       @id @default(uuid())
  categoryId        String       @map("category_id")
  name              String
  description       String?
  price             Decimal      @db.Decimal(10, 2)
  imageUrl          String?      @map("image_url")
  discountType      DiscountType @default(none) @map("discount_type")
  discountValue     Decimal      @default(0) @map("discount_value") @db.Decimal(10, 2)
  cookingTime       Int?         @map("cooking_time") // минуты, опционально
  isAvailable       Boolean      @default(true) @map("is_available") // временно отключить
  isActive          Boolean      @default(true) @map("is_active")
  archivedAt        DateTime?    @map("archived_at")
  activeBeforeArchive Boolean?   @map("active_before_archive")
  sortOrder         Int          @default(0) @map("sort_order")
  trackInventory    Boolean      @default(false) @map("track_inventory")
  stock             Int?
  initialStock      Int?         @map("initial_stock")
  unit              String       @default("шт")
  // null = наследовать направление от категории; задано — приоритет над категорией.
  prepStation       String? @map("prep_station")
  // true — это «шапка» сета (состав в SetComponent), а не обычное блюдо.
  isSet             Boolean      @default(false) @map("is_set")
  // Весовое блюдо открывает у официанта отдельный выбор граммов вместо обычных вариантов.
  isWeighted        Boolean      @default(false) @map("is_weighted")
  // Система измерения весового блюда: weight (г/кг) или volume (мл/л).
  weightedMeasure   String       @default("weight") @map("weighted_measure")
  // Количество базовых единиц, за которое указана цена (1, 100 или 1000).
  weightedPriceBase Int          @default(100) @map("weighted_price_base")
  // Отдельное название для озвучки кухни (если задано — используется вместо name).
  voiceName         String?      @map("voice_name")
  popularityScore   Float        @default(0) @map("popularity_score")
  scoreUpdatedAt    DateTime?    @map("score_updated_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  variants           DishVariant[]
  // Состав сета (если это сет) и вхождения этого блюда в чужие сеты.
  setComponents      SetComponent[]          @relation("SetOf")
  inSetComponents    SetComponent[]          @relation("ComponentOf")
  // Снимки этого блюда в изменённых составах заказов.
  origOrderSetItems  OrderItemSetComponent[] @relation("OrigDish")
  finalOrderSetItems OrderItemSetComponent[] @relation("FinalDish")
  qrSessionItems     QrSessionItem[]
  // Техкарта блюда: какие ингредиенты и сколько уходит на 1 порцию.
  stockIngredientId String? @map("stock_ingredient_id")
  stockAmount Decimal @default(1) @db.Decimal(14, 3) @map("stock_amount")
  recipeVersion Int @default(1) @map("recipe_version")
  catalogKind String @default("recipe") @map("catalog_kind")
  menuCreateKey String? @unique @map("menu_create_key")
  recipeMetadata Json? @map("recipe_metadata")
  stockIngredient Ingredient? @relation("DirectStockIngredient", fields: [stockIngredientId], references: [id], onDelete: Restrict)
  allowIngredientExclusions Boolean @default(false) @map("allow_ingredient_exclusions")
  excludableIngredientIds Json? @map("excludable_ingredient_ids")
  modifierGroups MenuModifierGroup[]
  recipeRevisions RecipeRevision[]
  recipeItems        RecipeItem[]
  taxId              String? @map("tax_id")
  taxExempt          Boolean @default(false) @map("tax_exempt")
  tax                MenuTax? @relation(fields: [taxId], references: [id], onDelete: NoAction)

  @@index([taxId])
  @@map("dishes")
}

model SetComponent {
  cafeId        String?  @map("cafe_id")
  id            String   @id @default(uuid())
  setId         String   @map("set_id")
  dishId        String   @map("dish_id")
  // Вариант блюда в составе (например, «1 л»). null — блюдо без вариантов / базовое.
  dishVariantId String?  @map("dish_variant_id")
  quantity      Int      @default(1)
  sortOrder     Int      @default(0) @map("sort_order")
  removable     Boolean  @default(true)
  replaceable   Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  set         Dish         @relation("SetOf", fields: [setId], references: [id], onDelete: Cascade)
  dish        Dish         @relation("ComponentOf", fields: [dishId], references: [id], onDelete: Cascade)
  dishVariant DishVariant? @relation(fields: [dishVariantId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([dishId])
  @@index([dishVariantId])
  @@map("set_components")
}

model DishVariant {
  cafeId       String?  @map("cafe_id")
  id           String   @id @default(uuid())
  dishId       String   @map("dish_id")
  name         String
  price        Decimal  @db.Decimal(10, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  stockIngredientId String? @map("stock_ingredient_id")
  stockAmount Decimal @default(1) @db.Decimal(14,3) @map("stock_amount")
  stockIngredient Ingredient? @relation("DirectVariantIngredient", fields: [stockIngredientId], references: [id], onDelete: Restrict)
  stock        Int?
  initialStock Int?     @map("initial_stock")
  unit         String   @default("шт")
  recipeMetadata Json? @map("recipe_metadata")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dish               Dish                    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  setComponents      SetComponent[]
  recipeItems        RecipeItem[]
  finalOrderSetItems OrderItemSetComponent[] @relation("FinalVariant")

  @@index([dishId])
  @@unique([dishId, id])
  @@map("dish_variants")
}

model Order {
  cafeId                 String?        @map("cafe_id")
  id                     String         @id @default(uuid())
  // Номер заказа сбрасывается каждый день (нумерация в пределах businessDate).
  orderNumber            String         @map("order_number")
  // Бизнес-день заказа (локальная полночь) — для дневной нумерации и уникальности номера в дне.
  businessDate           DateTime       @default(now()) @map("business_date")
  tableId                String         @map("table_id")
  splitFromOrderId       String?        @map("split_from_order_id")
  // nullable: заказ из QR-меню создаётся без официанта (source=qr).
  waiterId               String?        @map("waiter_id")
  payrollOpenedById      String?        @map("payroll_opened_by_id")
  // Источник заказа: pos — в зале, qr — QR-меню, delivery — доставка с кассы или из интеграции.
  source                 String         @default("pos")
  // Внешний идентификатор есть только у заказов из интеграции.
  externalOrderId        String?        @map("external_order_id")
  deliveryCustomerName   String?        @map("delivery_customer_name")
  deliveryCustomerPhone  String?        @map("delivery_customer_phone")
  deliveryAddress        String?        @map("delivery_address")
  waiterShiftId          String?        @map("waiter_shift_id")
  status                 OrderStatus    @default(draft)
  totalAmount            Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  discountAmount         Decimal        @default(0) @map("discount_amount") @db.Decimal(10, 2)
  serviceChargeAmount    Decimal        @default(0) @map("service_charge_amount") @db.Decimal(10, 2)
  roundOrderTotal        Boolean        @default(false) @map("round_order_total")
  roundingAmount         Decimal        @default(0) @map("rounding_amount") @db.Decimal(10, 2)
  finalAmount            Decimal        @default(0) @map("final_amount") @db.Decimal(10, 2)
  refundedAmount         Decimal        @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  paymentStatus          PaymentStatus  @default(pending) @map("payment_status")
  paymentMethod          PaymentMethod? @map("payment_method")
  comment                String?
  requiresWaiterDecision Boolean        @default(false) @map("requires_waiter_decision")
  idempotencyKey         String?        @unique @map("idempotency_key")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  closedAt               DateTime?      @map("closed_at")

  // ККМ / фискализация (Кыргызстан). Заполняются при пробитии фискального чека через ККМ.
  // null = ККМ выключена или чек ещё не пробит. Хранятся на заказе: один фискальный чек на
  // оплаченный заказ (карточка заказа и кнопка «Повторить» работают per-order).
  fiscalReceiptNumber String?   @map("fiscal_receipt_number") // номер фискального чека
  fiscalSign          String?   @map("fiscal_sign") // фискальный признак
  fiscalQrCode        String?   @map("fiscal_qr_code") // QR ГНС для проверки чека
  fiscalError         String?   @map("fiscal_error") // текст ошибки ККМ (для бейджа и повтора)
  fiscalizedAt        DateTime? @map("fiscalized_at") // момент успешного пробития

  table                Table                 @relation(fields: [tableId], references: [id])
  splitFromOrder       Order?                @relation("SplitOrderFamily", fields: [splitFromOrderId], references: [id], onDelete: NoAction)
  splitOrders          Order[]               @relation("SplitOrderFamily")
  waiter               User?                 @relation("WaiterOrders", fields: [waiterId], references: [id])
  payrollOpenedBy      User?                 @relation("PayrollOrderOpener", fields: [payrollOpenedById], references: [id], onDelete: Restrict)
  waiterShift          WaiterShift?          @relation(fields: [waiterShiftId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  taxes                OrderTax[]
  kitchenEvents        KitchenEvent[]
  incidents            Incident[]
  actions              OrderAction[]
  receiptPrintRequests ReceiptPrintRequest[]
  refunds              OrderRefund[]
  cancellationRequests OrderItemCancellationRequest[]
  // Заполняется, если заказ создан из QR-сессии стола.
  qrSession            QrTableSession?

  @@unique([cafeId, businessDate, orderNumber])
  @@unique([cafeId, externalOrderId])
  @@index([status])
  @@index([source, status])
  @@index([tableId])
  @@index([splitFromOrderId])
  @@index([waiterId])
  @@index([payrollOpenedById])
  @@index([waiterShiftId])
  @@map("orders")
}

model OrderAction {
  cafeId         String?  @map("cafe_id")
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  type           String
  idempotencyKey String   @map("idempotency_key")
  userId         String?  @map("user_id")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([type, idempotencyKey])
  @@index([orderId, type])
  @@map("order_actions")
}

model OrderTax {
  id           String      @id @default(uuid())
  cafeId       String?     @map("cafe_id")
  orderId      String      @map("order_id")
  taxId        String      @map("tax_id")
  name         String
  rate         Decimal     @db.Decimal(5, 2)
  type         MenuTaxType
  salesAmount  Decimal     @map("sales_amount") @db.Decimal(12, 2)
  amount       Decimal     @db.Decimal(12, 2)
  soldAt       DateTime    @map("sold_at")
  reversedAt   DateTime?   @map("reversed_at")
  fiscalizedAt DateTime?   @map("fiscalized_at")
  itemAmounts  Json?       @map("item_amounts")
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, soldAt, taxId])
  @@index([cafeId, soldAt])
  @@index([cafeId, reversedAt])
  @@map("order_taxes")
}

model CashShift {
  id             String    @id @default(uuid())
  cafeId         String    @map("cafe_id")
  accountId      String    @map("account_id")
  openedById     String    @map("opened_by_id")
  closedById     String?   @map("closed_by_id")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingAmount  Decimal   @map("opening_amount") @db.Decimal(14, 2)
  expectedAmount Decimal?  @map("expected_amount") @db.Decimal(14, 2)
  actualAmount   Decimal?  @map("actual_amount") @db.Decimal(14, 2)
  difference     Decimal?  @db.Decimal(14, 2)
  closingComment String?   @map("closing_comment") @db.VarChar(500)
  closeEmployeeShifts Boolean @default(false) @map("close_employee_shifts")

  deletedOperations CashShiftDeletedOperation[]

  @@index([cafeId, openedAt])
  @@map("cash_shifts")
}

model CashShiftDeletedOperation {
  id            String           @id
  cafeId        String           @map("cafe_id")
  cashShiftId   String           @map("cash_shift_id")
  sourceKey     String           @map("source_key")
  kind          FinanceEntryKind
  amount        Decimal          @db.Decimal(18, 2)
  category      String?
  note          String?
  actorName     String?          @map("actor_name")
  occurredAt    DateTime         @map("occurred_at")
  deletedById   String           @map("deleted_by_id")
  deletedByName String?          @map("deleted_by_name")
  deletedAt     DateTime         @default(now()) @map("deleted_at")
  shift         CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)

  @@unique([cafeId, sourceKey])
  @@index([cafeId, cashShiftId, occurredAt], map: "cash_shift_deleted_operations_shift_history_idx")
  @@map("cash_shift_deleted_operations")
}

model WaiterShift {
  cafeId    String?           @map("cafe_id")
  id        String            @id @default(uuid())
  waiterId  String            @map("waiter_id")
  startedAt DateTime          @default(now()) @map("started_at")
  endedAt   DateTime?         @map("ended_at")
  status    WaiterShiftStatus @default(active)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  waiter User    @relation("WaiterShifts", fields: [waiterId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([waiterId, status])
  @@map("waiter_shifts")
}

// Факт сдачи наличных сотрудником за смену (на конкретную дату).
// «Касса (сдал)» в отчёте по сменам — вводится администратором, не расчётное.
model ShiftCashReport {
  cafeId      String?  @map("cafe_id")
  id          String   @id @default(uuid())
  waiterId    String   @map("waiter_id")
  date        DateTime @db.Date
  cashHanded  Decimal  @default(0) @map("cash_handed") @db.Decimal(10, 2)
  cashReceivedAt DateTime? @map("cash_received_at")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  waiter User @relation("WaiterCashReports", fields: [waiterId], references: [id], onDelete: Cascade)

  @@unique([waiterId, date])
  @@map("shift_cash_reports")
}

model OrderItem {
  cafeId                  String?            @map("cafe_id")
  stockSourceLineId String? @map("stock_source_line_id")
  stockAccountingSnapshot Json? @map("stock_accounting_snapshot")
  modifierSelections Json? @map("modifier_selections")
  excludedIngredientIds Json? @map("excluded_ingredient_ids")
  excludedIngredientNames Json? @map("excluded_ingredient_names")
  id                      String             @id @default(uuid())
  orderId                 String             @map("order_id")
  // nullable: блюдо может быть полностью удалено из меню — позиция остаётся в истории по снимкам.
  dishId                  String?            @map("dish_id")
  dishVariantId           String?            @map("dish_variant_id")
  dishNameSnapshot        String             @map("dish_name_snapshot")
  payrollCategoryId       String?            @map("payroll_category_id")
  dishVariantNameSnapshot String?            @map("dish_variant_name_snapshot")
  // Выбранный вес позиции. Цена остаётся фиксированной ценой блюда.
  weightGrams             Int?               @map("weight_grams")
  // Снимок названия для озвучки (voiceName блюда на момент заказа).
  dishVoiceSnapshot       String?            @map("dish_voice_snapshot")
  priceSnapshot           Decimal            @map("price_snapshot") @db.Decimal(10, 2)
  quantity                Int                @default(1)
  refundedQuantity        Int                @default(0) @map("refunded_quantity")
  discountAmount          Decimal            @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalPrice              Decimal            @map("final_price") @db.Decimal(10, 2)
  status                  OrderItemStatus    @default(new)
  prepStation             String             @default("kitchen") @map("prep_station")
  comment                 String?
  // «С собой» (навынос) — кухня видит, что позицию нужно упаковать.
  takeaway                Boolean            @default(false)
  rejectReason            String?            @map("reject_reason")
  rejectionDecision       RejectionDecision? @map("rejection_decision")
  replacementForItemId    String?            @map("replacement_for_item_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish          Dish?                   @relation(fields: [dishId], references: [id], onDelete: SetNull)
  dishVariant   DishVariant?            @relation(fields: [dishVariantId], references: [id], onDelete: SetNull)
  // Состав сета с изменениями (если эта позиция — сет).
  setComponents OrderItemSetComponent[]

  @@index([orderId])
  @@index([cafeId, prepStation, status, updatedAt])
  @@index([dishVariantId])
  @@map("order_items")
}

enum SetComponentAction {
  default
  removed
  replaced
}

enum RejectionDecision {
  pending
  removed
  replaced
}

model OrderItemSetComponent {
  cafeId                      String?            @map("cafe_id")
  id                          String             @id @default(uuid())
  orderItemId                 String             @map("order_item_id")
  // nullable: блюдо состава может быть удалено из меню — имя сохраняется в снимке.
  originalDishId              String?            @map("original_dish_id")
  originalNameSnapshot        String             @map("original_name_snapshot")
  // Снимок названия варианта блюда состава (например, «1 л»), если он выбран.
  originalVariantNameSnapshot String?            @map("original_variant_name_snapshot")
  finalDishId                 String?            @map("final_dish_id")
  finalVariantId              String?            @map("final_variant_id")
  finalNameSnapshot           String?            @map("final_name_snapshot")
  finalVariantNameSnapshot    String?            @map("final_variant_name_snapshot")
  action                      SetComponentAction @default(default)
  // Кухня отмечает каждое блюдо состава сета отдельно (как обычную позицию).
  status                      OrderItemStatus    @default(new)
  rejectReason                String?            @map("reject_reason")
  quantity                    Int                @default(1)
  sortOrder                   Int                @default(0) @map("sort_order")
  comment                     String?
  priceDelta                  Decimal            @default(0) @map("price_delta") @db.Decimal(10, 2)
  createdAt                   DateTime           @default(now()) @map("created_at")

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  originalDish Dish?        @relation("OrigDish", fields: [originalDishId], references: [id], onDelete: SetNull)
  finalDish    Dish?        @relation("FinalDish", fields: [finalDishId], references: [id])
  finalVariant DishVariant? @relation("FinalVariant", fields: [finalVariantId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([finalVariantId])
  @@map("order_item_set_components")
}

model Payment {
  cafeId    String?       @map("cafe_id")
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  amount    Decimal       @db.Decimal(10, 2)
  refundedAmount Decimal  @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  method    PaymentMethod
  source    PaymentSource @default(normal)
  status    PaymentStatus @default(paid)
  paidAt    DateTime      @default(now()) @map("paid_at")
  cashierId String        @map("cashier_id")

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashier User  @relation(fields: [cashierId], references: [id])

  @@map("payments")
}

model OrderRefund {
  id                    String            @id @default(uuid())
  cafeId                String?           @map("cafe_id")
  orderId               String            @map("order_id")
  itemId                String?           @map("item_id")
  quantity              Int?
  reason                String
  status                OrderRefundStatus @default(pending)
  amount                Decimal           @db.Decimal(10, 2)
  items                 Json
  paymentParts          Json              @map("payment_parts")
  taxReversals          Json              @map("tax_reversals")
  quoteVersion          String            @map("quote_version")
  requestedById         String            @map("requested_by_id")
  requestedByName       String            @map("requested_by_name")
  createdAt             DateTime          @default(now()) @map("created_at")
  decidedById           String?           @map("decided_by_id")
  decidedByName         String?           @map("decided_by_name")
  decidedAt             DateTime?         @map("decided_at")
  fiscalRefundReference String?           @map("fiscal_refund_reference")
  restockedGoods        Boolean           @default(false) @map("restocked_goods")
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, fiscalRefundReference], map: "order_refunds_fiscal_reference_key")
  @@index([orderId, createdAt])
  @@index([cafeId, status, createdAt])
  @@index([cafeId, status, decidedAt])
  @@map("order_refunds")
}

enum OrderItemCancellationStatus {
  pending
  approved
  rejected
}

model OrderItemCancellationRequest {
  id              String                      @id @default(uuid())
  cafeId          String?                     @map("cafe_id")
  orderId         String                      @map("order_id")
  itemId          String                      @map("item_id")
  itemName        String                      @map("item_name")
  quantity        Int
  reason          String
  status          OrderItemCancellationStatus @default(pending)
  requestedById   String                      @map("requested_by_id")
  requestedByName String                      @map("requested_by_name")
  createdAt       DateTime                    @default(now()) @map("created_at")
  decidedById     String?                     @map("decided_by_id")
  decidedAt       DateTime?                   @map("decided_at")
  order           Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([cafeId, status, createdAt])
  @@index([orderId])
  @@map("order_item_cancellation_requests")
}

model KitchenEvent {
  cafeId      String?          @map("cafe_id")
  id          String           @id @default(uuid())
  orderId     String           @map("order_id")
  orderItemId String?          @map("order_item_id")
  type        KitchenEventType
  prepStation String?          @map("prep_station")
  reason      String?
  comment     String?
  createdById String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@map("kitchen_events")
}

model PenaltyReward {
  cafeId      String?     @map("cafe_id")
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  type        PenaltyType
  amount      Decimal     @db.Decimal(10, 2)
  reason      String
  createdById String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  user      User @relation("PenaltyTarget", fields: [userId], references: [id])
  createdBy User @relation("PenaltyAuthor", fields: [createdById], references: [id])

  @@map("staff_penalties_rewards")
}

model Incident {
  cafeId       String?        @map("cafe_id")
  id           String         @id @default(uuid())
  type         String
  description  String?
  tableId      String?        @map("table_id")
  orderId      String?        @map("order_id")
  userId       String?        @map("user_id")
  damageAmount Decimal?       @map("damage_amount") @db.Decimal(10, 2)
  photoUrl     String?        @map("photo_url")
  status       IncidentStatus @default(new)
  createdById  String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  table     Table? @relation(fields: [tableId], references: [id])
