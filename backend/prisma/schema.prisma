  createdBy User   @relation("IncidentAuthor", fields: [createdById], references: [id])

  @@map("incidents")
}

model AuditLog {
  cafeId      String?  @map("cafe_id")
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userName    String?  @map("user_name") // имя на момент действия (не зависит от переименования)
  userRole    String?  @map("user_role")
  actionType  String   @map("action_type")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  tableId     String?  @map("table_id")
  orderId     String?  @map("order_id")
  description String?
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([actionType])
  @@index([userId])
  @@index([orderId])
  @@index([tableId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Настройки заведения (singleton, id = "default"). Этап 8.
model Settings {
  taxesEnabled Boolean @default(false) @map("taxes_enabled")
  useFloorPlan Boolean @default(false) @map("use_floor_plan")
  cashShiftsEnabled            Boolean @default(false) @map("cash_shifts_enabled")
  cashShiftRequireClosedOrders Boolean @default(false) @map("cash_shift_require_closed_orders")
  cashHandoverEnabled          Boolean @default(false) @map("cash_handover_enabled")
  waiterOrderPermissions Json? @map("waiter_order_permissions")
  cafeId                       String? @unique @map("cafe_id")
  id                           String  @id @default(uuid())
  cafeName                     String  @default("EDU CAFE") @map("cafe_name")
  address                      String  @default("г. Бишкек, ул. Киевская 120")
  phone                        String  @default("+996 500 123 456")
  phone2                       String  @default("+996 700 123 456")
  instagram                    String?
  website                      String?
  receiptText                  String  @default("Спасибо за покупку!") @map("receipt_text")
  receiptLanguage              String  @default("ru") @map("receipt_language")
  receiptPrintCafeName         Boolean @default(true) @map("receipt_print_cafe_name")
  receiptPrintAddress          Boolean @default(true) @map("receipt_print_address")
  receiptPrintPhone            Boolean @default(true) @map("receipt_print_phone")
  receiptLogoData              String? @map("receipt_logo_data")
  roundOrderTotal              Boolean @default(false) @map("round_order_total")
  telegramStockAlertsEnabled   Boolean @default(false) @map("telegram_stock_alerts_enabled")
  telegramStockChatId          String? @map("telegram_stock_chat_id")
  telegramStockAlertState      Json?   @map("telegram_stock_alert_state")
  serviceChargeAmount          Decimal @default(0) @map("service_charge_amount") @db.Decimal(10, 2)
  language                     String  @default("ru") // ru | ky
  payQr                        Boolean @default(true) @map("pay_qr")
  payCash                      Boolean @default(true) @map("pay_cash")
  payCard                      Boolean @default(true) @map("pay_card")
  qrImageUrl                   String? @map("qr_image_url") // data URL загруженного QR-кода (один на заведение)
  printerConnected             Boolean @default(false) @map("printer_connected")
  receiptPrintRequestsOnly     Boolean @default(false) @map("receipt_print_requests_only")
  allowNegativeIngredientStock Boolean @default(false) @map("allow_negative_ingredient_stock")
  expenseWriteoffReasons WarehouseWriteoffReason[] @default([]) @map("expense_writeoff_reasons")
  warehouseProductionEnabled Boolean @default(false) @map("warehouse_production_enabled")
  warehouseProcessingEnabled Boolean @default(false) @map("warehouse_processing_enabled")

  // Интеграция внешнего сайта/приложения доставки. Полный API-ключ не хранится:
  // только SHA-256 и безопасный префикс для отображения владельцу.
  deliveryEnabled      Boolean @default(false) @map("delivery_enabled")
  deliveryApiKeyHash   String? @unique @map("delivery_api_key_hash")
  deliveryApiKeyPrefix String? @map("delivery_api_key_prefix")
  // Скрытый служебный стол сохраняет совместимость с единым Order workflow.
  deliveryTableId      String? @map("delivery_table_id")

  // Экран очереди заказов (табло в зале): включается по желанию владельца.
  // Режим: table — показываем номера столов, number — номера заказов.
  queueDisplayEnabled Boolean @default(false) @map("queue_display_enabled")
  queueDisplayMode    String  @default("table") @map("queue_display_mode") // table | number
  // Короткий код для публичной ссылки табло (/q/CODE) — чтобы вводить на ТВ
  // вручную, без длинного UUID кафе. Генерируется при включении табло.
  queueDisplayCode    String? @unique @map("queue_display_code")

  // QR-меню: опциональная гео-проверка присутствия гостя у кафе.
  // Владелец включает по желанию, делится координатами кафе и задаёт радиус.
  // Заказ блокируется, если гость дальше радиуса + буфер на погрешность GPS.
  qrGeoEnabled Boolean @default(false) @map("qr_geo_enabled")
  qrGeoLat     Float?  @map("qr_geo_lat")
  qrGeoLng     Float?  @map("qr_geo_lng")
  qrGeoRadius  Int     @default(150) @map("qr_geo_radius") // метры

  // ККМ / фискализация (Кыргызстан). Владелец выбирает провайдера и вводит ключи.
  // null/пусто в fiscalProvider = ККМ выключена, печать фискального чека недоступна.
  fiscalProvider      String? @map("fiscal_provider") // ekassa | yakassa | null
  fiscalEkassaApiKey  String? @map("fiscal_ekassa_api_key")
  fiscalEkassaUrl     String? @map("fiscal_ekassa_url") // базовый URL eKassa API (из документации)
  fiscalEkassaInn     String? @map("fiscal_ekassa_inn") // ИНН заведения
  fiscalYakassaApiKey String? @map("fiscal_yakassa_api_key")
  fiscalYakassaUrl    String? @map("fiscal_yakassa_url")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model PushSubscription {
  cafeId    String?  @map("cafe_id")
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Мобильное устройство пользователя для native push (React Native клиент).
// Отдельно от PushSubscription (Web Push для PWA) — каналы не пересекаются.
model UserDevice {
  cafeId      String?      @map("cafe_id")
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  platform    String // 'android' | 'ios' | 'web-pwa'
  pushProvider PushProvider @default(EXPO) @map("push_provider")
  deviceId    String?      @map("device_id")
  pushToken   String?      @unique @map("push_token")
  appVersion  String?      @map("app_version")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushProvider, isActive])
  @@map("user_devices")
}

// Запрос официанта на печать чека — подтверждается администратором (раздел «Печать чека»).
model ReceiptPrintRequest {
  cafeId      String?            @map("cafe_id")
  id          String             @id @default(uuid())
  orderId     String             @map("order_id")
  waiterId    String             @map("waiter_id")
  tableNumber Int                @map("table_number")
  orderNumber String             @map("order_number")
  amount      Decimal            @db.Decimal(10, 2)
  type        ReceiptPrintType   @default(receipt)
  status      ReceiptPrintStatus @default(pending)
  decidedById String?            @map("decided_by") // администратор, принявший решение
  createdAt   DateTime           @default(now()) @map("created_at")
  decidedAt   DateTime?          @map("decided_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiter User  @relation("WaiterReceiptPrints", fields: [waiterId], references: [id])

  @@index([status])
  @@index([waiterId])
  @@map("receipt_print_requests")
}

// ---------- QR-меню стола ----------
// Общий заказ стола, который гости наполняют со своих телефонов до отправки в POS.
// Черновик (draft) живёт до submit; после submit привязывается к реальному Order.

model QrTableSession {
  cafeId           String?  @map("cafe_id")
  id               String   @id @default(uuid())
  tableId          String   @map("table_id")
  status           String   @default("draft") // draft | submitted | closed
  submittedOrderId String?  @unique @map("submitted_order_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  table          Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  submittedOrder Order?          @relation(fields: [submittedOrderId], references: [id], onDelete: SetNull)
  guests         QrGuest[]
  items          QrSessionItem[]

  @@index([tableId, status])
  @@map("qr_table_sessions")
}

model QrGuest {
  cafeId     String?  @map("cafe_id")
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  // Секрет гостя из localStorage — идентифицирует устройство без авторизации.
  guestKey   String   @map("guest_key")
  guestLabel String   @map("guest_label") // «Гость 1», «Гость 2», …
  isOnline   Boolean  @default(true) @map("is_online")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  session QrTableSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   QrSessionItem[]

  @@unique([sessionId, guestKey])
  @@index([sessionId])
  @@map("qr_guests")
}

model QrSessionItem {
  cafeId         String?  @map("cafe_id")
  id             String   @id @default(uuid())
  sessionId      String   @map("session_id")
  guestId        String   @map("guest_id")
  // nullable: блюдо может быть удалено из меню — отображение по снимку.
  dishId         String?  @map("dish_id")
  variantId      String?  @map("variant_id")
  quantity       Int      @default(1)
  snapshotName   String   @map("snapshot_name")
  variantName    String?  @map("variant_name")
  snapshotPrice  Decimal  @map("snapshot_price") @db.Decimal(10, 2)
  // Зарезервировано под добавки/модификаторы (в v1 не используется).
  selectedAddons Json?    @map("selected_addons")
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  session QrTableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guest   QrGuest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  dish    Dish?          @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([guestId])
  @@map("qr_session_items")
}

// ---------- Склад ----------

// Сырьё (ингредиент). Деньги — Decimal(12,2), количества — Decimal(12,3),
// чтобы хранить дробные граммы/килограммы (например, 0.120 кг).
model Ingredient {
  cafeId            String?            @map("cafe_id")
  id                String             @id @default(uuid())
  name              String
  // Тип единицы и display-единица, выбранная админом (g|kg|ml|l|pcs).
  unitType          IngredientUnitType @default(count) @map("unit_type")
  displayUnit       String             @default("pcs") @map("display_unit")
  pieceWeightGrams  Decimal?           @map("piece_weight_grams") @db.Decimal(14, 3)
  roundPieceWriteoff Boolean           @default(false) @map("round_piece_writeoff")
  // ВНИМАНИЕ: stock/avgCost/lowStockThreshold хранятся в БАЗОВЫХ единицах (g|ml|pcs).
  valuationKnown Boolean @default(false) @map("valuation_known")
  stock             Decimal            @default(0) @db.Decimal(14, 3) // в базовых единицах
  avgCost           Decimal            @default(0) @map("avg_cost") @db.Decimal(20, 8) // себестоимость за базовую единицу
  lowStockThreshold Decimal            @default(0) @map("low_stock_threshold") @db.Decimal(14, 3) // база
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  kind IngredientKind @default(raw)
  category String?
  barcode String?
  supplier String?
  supplierId String? @map("supplier_id")
  supplierRecord WarehouseSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  processingLosses Json? @map("processing_losses")
  modifierOptions MenuModifierOption[]
  processingLines ProcessingLine[]
  purchaseUnits Json @default("[]") @map("purchase_units")
  purchaseUnit String? @map("purchase_unit")
  purchaseFactor Decimal? @map("purchase_factor") @db.Decimal(14, 6)
  preparationMode String @default("stocked") @map("preparation_mode")
  preparationRevisions PreparationRecipeRevision[]
  directDishes Dish[] @relation("DirectStockIngredient")
  directVariants DishVariant[] @relation("DirectVariantIngredient")
  isPrepared    Boolean @default(false) @map("is_prepared")
  recipeItems   RecipeItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]
  warehouseStock WarehouseStock[]
  preparationRecipe PreparationRecipe? @relation("PreparedIngredient")
  preparationInputs PreparationRecipeItem[]
  warehouseDocumentItems WarehouseDocumentItem[]

  @@index([cafeId, kind])
  @@index([cafeId, barcode])
  @@map("ingredients")
}

// Строка техкарты: сколько ингредиента уходит на 1 порцию блюда.
model RecipeItem {
  cafeId       String?  @map("cafe_id")
  id           String   @id @default(uuid())
  dishId       String   @map("dish_id")
  variantId    String?  @map("variant_id")
  ingredientId String   @map("ingredient_id")
  amount       Decimal  @db.Decimal(14, 3) // количество на 1 порцию в БАЗОВЫХ единицах
  amountUnit   String   @default("pcs") @map("amount_unit") // display-единица, выбранная при вводе
  fromCommonWarehouse Boolean @default(false) @map("from_common_warehouse")
  warehouseId String? @map("warehouse_id")
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  processingMethod String? @map("processing_method")
  processingStages Json? @map("processing_stages")
  processingBasis String? @map("processing_basis")
  variantAmounts Json? @map("variant_amounts")
  netAmount Decimal? @map("net_amount") @db.Decimal(14, 3)
  measuredNetWeightGrams Decimal? @map("measured_net_weight_grams") @db.Decimal(14, 3)
  lossPercent Decimal @default(0) @map("loss_percent") @db.Decimal(20, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  variant    DishVariant? @relation(fields: [dishId, variantId], references: [dishId, id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([dishId, variantId, ingredientId])
  @@index([dishId])
  @@index([ingredientId])
  @@map("recipe_items")
}

model Warehouse {
  id String @id @default(uuid())
  cafeId String @map("cafe_id")
  name String
  address String?
  modifierOptions MenuModifierOption[]
  processingLines ProcessingLine[]
  isDefault Boolean @default(false) @map("is_default")
  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  stock WarehouseStock[]
  stationRoutes StationWarehouse[]
  purchases Purchase[]
  movements StockMovement[]
  documents WarehouseDocument[]
  recipeItems RecipeItem[]

  @@unique([cafeId, name])
  @@unique([cafeId, id])
  @@map("warehouses")
}

model WarehouseStock {
  cafeId String @map("cafe_id")
  warehouseId String @map("warehouse_id")
  ingredientId String @map("ingredient_id")
  stock Decimal @default(0) @db.Decimal(14, 3)
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(20, 8)
  valuationKnown Boolean @default(false) @map("valuation_known")
  warehouse Warehouse @relation(fields: [cafeId, warehouseId], references: [cafeId, id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([warehouseId, ingredientId])
  @@index([cafeId, ingredientId])
  @@map("warehouse_stock")
}

model IngredientCategory {
  cafeId String @map("cafe_id")
  name   String
  cafe   Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([cafeId, name])
  @@map("ingredient_categories")
}

model WriteoffReason {
  id             String @id @default(uuid())
  cafeId         String @map("cafe_id")
  name           String
  normalizedName String @map("normalized_name")
  expense        Boolean @default(false)
  archivedAt     DateTime? @map("archived_at")
  cafe           Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  documents      WarehouseDocument[]

  @@unique([cafeId, id])
  @@map("writeoff_reasons")
}

model WarehouseDocument {
  id              String                  @id @default(uuid())
  cafeId          String                  @map("cafe_id")
  warehouseId     String                  @map("warehouse_id")
  kind            WarehouseDocumentKind
  mode            WarehouseInventoryMode?
  reason          WarehouseWriteoffReason?
  writeoffReasonId String? @map("writeoff_reason_id")
  writeoffReason   WriteoffReason? @relation(fields: [cafeId, writeoffReasonId], references: [cafeId, id], onDelete: NoAction)
  note            String?
  sourceLines     Json?                   @map("source_lines")
  destinationWarehouseId String? @map("destination_warehouse_id")
  sourcePurchaseId String? @map("source_purchase_id")
  requestKey String? @map("request_key")
  reversedAt DateTime? @map("reversed_at")
  reversedById String? @map("reversed_by_id")
  reversedByName String? @map("reversed_by_name")
  reversalReason String? @map("reversal_reason")
  status          WarehouseDocumentStatus @default(draft)
  revision        Int                     @default(0)
  createdAt       DateTime                @default(now()) @map("created_at")
  submittedAt     DateTime?               @map("submitted_at")
  postedAt        DateTime?               @map("posted_at")
  reopenedAt      DateTime?               @map("reopened_at")
  countedAt       DateTime?               @map("counted_at")
  effectiveAt     DateTime?               @map("effective_at")
  createdById     String                  @map("created_by_id")
  createdByName   String                  @map("created_by_name")
  submittedById   String?                 @map("submitted_by_id")
  submittedByName String?                 @map("submitted_by_name")
  postedById      String?                 @map("posted_by_id")
  postedByName    String?                 @map("posted_by_name")
  warehouse       Warehouse               @relation(fields: [cafeId, warehouseId], references: [cafeId, id], onDelete: Cascade, map: "warehouse_documents_warehouse_fk")
  items           WarehouseDocumentItem[]

  @@unique([cafeId, id])
  @@unique([cafeId, requestKey])
  @@index([cafeId, writeoffReasonId])
  @@index([cafeId, warehouseId, kind, createdAt], map: "warehouse_documents_cafe_id_warehouse_id_kind_created_at_idx")
  @@map("warehouse_documents")
}

model WarehouseDocumentItem {
  cafeId              String            @map("cafe_id")
  documentId          String            @map("document_id")
  ingredientId        String            @map("ingredient_id")
  name                String
  unit                String
  expected            Decimal?          @db.Decimal(14, 3)
  quantity            Decimal?          @db.Decimal(14, 3)
  reopenedQuantity    Decimal?          @map("reopened_quantity") @db.Decimal(14, 3)
  difference          Decimal?          @db.Decimal(14, 3)
  unitCost            Decimal?          @map("unit_cost") @db.Decimal(20, 8)
  inventoryGeneration Int?              @map("inventory_generation")
  document            WarehouseDocument @relation(fields: [cafeId, documentId], references: [cafeId, id], onDelete: Cascade, map: "warehouse_document_items_document_fk")
  ingredient          Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([documentId, ingredientId])
  @@index([cafeId, ingredientId])
  @@map("warehouse_document_items")
  costKnown Boolean @default(false) @map("cost_known")
}

model StationWarehouse {
  cafeId String @map("cafe_id")
  stationId String @map("station_id")
  warehouseId String @map("warehouse_id")
  warehouse Warehouse @relation(fields: [cafeId, warehouseId], references: [cafeId, id], onDelete: Cascade)

  @@id([cafeId, stationId])
  @@map("station_warehouses")
}

model PreparationRecipe {
  cafeId String @map("cafe_id")
  ingredientId String @id @map("ingredient_id")
  outputAmount Decimal @map("output_amount") @db.Decimal(14, 3)
  outputUnit String @map("output_unit")
  instructions String?
  ingredient Ingredient @relation("PreparedIngredient", fields: [ingredientId], references: [id], onDelete: Cascade)
  items PreparationRecipeItem[]

  @@index([cafeId])
  @@map("preparation_recipes")
}

model PreparationRecipeRevision {
  id           BigInt     @id @default(autoincrement())
  cafeId       String     @map("cafe_id")
  ingredientId String     @map("ingredient_id")
  replacedAt   DateTime   @default(now()) @map("replaced_at")
  snapshot     String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([cafeId, ingredientId, replacedAt], map: "preparation_recipe_revisions_cafe_id_ingredient_id_replaced_idx")
  @@map("preparation_recipe_revisions")
}

model PreparationRecipeItem {
  cafeId String @map("cafe_id")
  recipeId String @map("recipe_id")
  ingredientId String @map("ingredient_id")
  amount Decimal @db.Decimal(14, 3)
  unit String
  netAmount Decimal? @map("net_amount") @db.Decimal(14, 3)
  measuredNetWeightGrams Decimal? @map("measured_net_weight_grams") @db.Decimal(14, 3)
  lossPercent Decimal @default(0) @map("loss_percent") @db.Decimal(20, 2)
  processingMethod String? @map("processing_method")
  processingStages Json? @map("processing_stages")
  processingBasis String? @map("processing_basis")
  recipe PreparationRecipe @relation(fields: [recipeId], references: [ingredientId], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([cafeId, ingredientId])
  @@map("preparation_recipe_items")
}

// Закупка. number — автоинкремент, на фронте показываем как «ЗКП-000142».
model Purchase {
  cafeId      String?        @map("cafe_id")
  id          String         @id @default(uuid())
  number      Int            @default(autoincrement())
  date        DateTime       @default(now())
  effectiveAt DateTime?      @map("effective_at")
  stockPostedAt DateTime?    @map("stock_posted_at")
  settlementKnownAt DateTime? @map("settlement_known_at")
  settlementOpeningPaid Decimal? @map("settlement_opening_paid") @db.Decimal(12, 2)
  supplier    String
  supplierId String? @map("supplier_id")
  supplierRecord WarehouseSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requestKey String? @map("request_key")
  note String?
  attachments Json?
  discount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  status      PurchaseStatus @default(draft)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  items PurchaseItem[]
  settlementEntries FinanceEntry[]
  warehouseId String? @map("warehouse_id")
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([cafeId, requestKey])
  @@unique([cafeId, id])
  @@index([cafeId, warehouseId])
  @@index([status])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  cafeId        String?  @map("cafe_id")
  id            String   @id @default(uuid())
  purchaseId    String   @map("purchase_id")
  ingredientId  String   @map("ingredient_id")
  packageId String? @map("package_id")
  package WarehousePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String? @map("package_name")
  packageUnit String? @map("package_unit")
  packageQuantity Decimal? @map("package_quantity") @db.Decimal(14, 6)
  packageFactor Decimal? @map("package_factor") @db.Decimal(14, 6)
  // Введённые значения (в display-единице) — для отображения документа.
  unit          String   @default("pcs") // display-единица, выбранная при закупке
  quantity      Decimal  @db.Decimal(14, 3) // в display-единице
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(20, 8) // цена за display-единицу
  total         Decimal  @db.Decimal(12, 2)
  grossTotal Decimal @default(0) @map("gross_total") @db.Decimal(12, 2)
  // Immutable purchase-tax snapshot. Stock valuation uses the untaxed line total.
  taxId String? @map("tax_id")
  taxName String? @map("tax_name")
  taxRate Decimal? @map("tax_rate") @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // Конвертированные значения — основа остатков и себестоимости.
  quantityBase  Decimal  @default(0) @map("quantity_base") @db.Decimal(14, 3) // в базовых единицах
  unitPriceBase Decimal  @default(0) @map("unit_price_base") @db.Decimal(20, 8) // цена за базовую единицу
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([purchaseId])
  @@index([ingredientId])
  @@map("purchase_items")
}

// Исходная операция в журнале; расчётные остатки и стоимость обновляются при пересчёте периода.
model StockMovement {
  cafeId       String?             @map("cafe_id")
  id           String              @id @default(uuid())
  ingredientId String              @map("ingredient_id")
  orderItemId  String?             @map("order_item_id")
  type         StockMovementType
  sourceType   StockMovementSource @map("source_type")
  sourceId     String?             @map("source_id") // id закупки или заказа
  // Все количества — в БАЗОВЫХ единицах ингредиента (g|ml|pcs).
  beforeStock  Decimal             @map("before_stock") @db.Decimal(14, 3)
  change       Decimal             @db.Decimal(14, 3)
  afterStock   Decimal             @map("after_stock") @db.Decimal(14, 3)
  costAtMoment Decimal             @map("cost_at_moment") @db.Decimal(20, 8) // себестоимость за базовую единицу
  comment      String?
  createdAt    DateTime            @default(now()) @map("created_at")
  recordedAt   DateTime?           @map("recorded_at")
  receiptValue Decimal?            @map("receipt_value") @db.Decimal(12, 2)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  warehouseId String? @map("warehouse_id")
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  valuationAdjustment Decimal @default(0) @map("valuation_adjustment") @db.Decimal(20, 8)
  actorId String? @map("actor_id")
  actorName String? @map("actor_name")
  reason String?
  recipeSnapshot Json? @map("recipe_snapshot")
  saleQuantity Int? @map("sale_quantity")
  warehouseKey String @default("default") @map("warehouse_key")
  saleCycle Int @default(0) @map("sale_cycle")
  saleLineId String? @map("sale_line_id")

  @@unique([type, sourceType, sourceId, orderItemId, ingredientId, saleCycle, warehouseKey], map: "stock_movements_order_item_cycle_key")
  @@index([cafeId, warehouseId, createdAt])
  @@index([ingredientId])
  @@index([orderItemId])
  @@index([sourceId, saleLineId])
  @@index([createdAt])
  @@index([type])
  @@index([sourceType])
  @@map("stock_movements")
  costKnown Boolean @default(false) @map("cost_known")
  beforeValuationKnown Boolean @default(false) @map("before_valuation_known")
  valuationKnown Boolean @default(false) @map("valuation_known")
}

