{
  "expo": {
    "name": "EDU POS",
    "slug": "edu-pos-mobile",
    "version": "0.1.1",
    "orientation": "default",
    "icon": "./assets/launcher-icon.png",
    "scheme": "edupos",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edupos.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EDU POS использует микрофон для внутренней рации Push-to-Talk.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.edupos.mobile",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/launcher-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#005BFF",
          "defaultChannel": "orders_v3",
          "sounds": [
            "./assets/sounds/notify.mp3",
            "./assets/sounds/new_order.mp3",
            "./assets/sounds/accept.mp3",
            "./assets/sounds/payment_sound.mp3"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf"
          ]
        }
      ],
      "./plugins/withInterFont",
      "./plugins/withPttBackgroundService"
    ],
    "extra": {
      "eas": {
        "projectId": "e4170c03-bd0d-430d-b7e4-0fdf300c561f"
      }
    },
    "owner": "eldarchkk"
  }
}
